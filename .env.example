OPENAI_API_KEY=your_openai_api_key_here

# Support agent model and runtime options
SUPPORT_AGENT_MODEL=gpt-5-mini
SUPPORT_AGENT_TEMPERATURE=0.1
SUPPORT_AGENT_DOMAIN_CONFIG=domains.yaml
SUPPORT_AGENT_CHECKPOINTER=.langgraph/support_agent.sqlite

# Analysis agent runtime options
ANALYSIS_AGENT_DOMAIN_CONFIG=domains.yaml
ANALYSIS_AGENT_RULES_CONFIG=analysis_rules.yaml
ANALYSIS_AGENT_CHECKPOINTER=.langgraph/analysis_agent.sqlite
