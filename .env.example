# OpenAI
OPENAI_API_KEY=sk-...

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=sweet-attention

# Support Agent
SUPPORT_AGENT_MODEL=gpt-4.1-mini
SUPPORT_AGENT_TEMPERATURE=0.1
SUPPORT_AGENT_CHECKPOINTER=.langgraph/support_agent.sqlite
SUPPORT_AGENT_DOMAIN_CONFIG=domains.yaml

# Analysis Agent
ANALYSIS_AGENT_MODEL=gpt-4.1
ANALYSIS_AGENT_TEMPERATURE=0.0
ANALYSIS_AGENT_CHECKPOINTER=.langgraph/analysis_agent.sqlite
ANALYSIS_AGENT_DOMAIN_CONFIG=domains.yaml
ANALYSIS_RESULTS_DB=.langgraph/analysis_results.sqlite
ANALYSIS_DATA_SEARCH_LIMIT=5
ANALYSIS_KNOWLEDGE_SEARCH_LIMIT=2
